# --- Server config ---
PORT=3001
CORS_ORIGIN=http://localhost:5173

# --- GitHub (passed through to the mcp_server.py subprocess) ---
GITHUB_TOKEN=

# --- LLM backend: "ollama" (local, default) or "groq" (cloud) ---
LLM_BACKEND=ollama

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Path to the shared Python MCP server (relative to server/ by default) ---
MCP_SERVER_PATH=../mcp_server.py
PYTHON_BIN=python3
